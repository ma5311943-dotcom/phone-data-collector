{
  "name": "student-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js, Express, MySQL and Cloudinary backend for the student management app.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:check": "node scripts/check-connections.js",
    "seed": "node scripts/seed.js",
    "render:build": "npm install && npx prisma migrate deploy && npx prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "multer-storage-cloudinary": "4.0.0"
  },
  "devDependencies": {
    "nodemon": "3.1.11",
    "prisma": "6.19.3"
  },
  "keywords": [],
  "type": "commonjs"
}
